# ── Database ──
DATABASE_URL=sqlite:///./rankwise.db

# ── LLM Provider ──
# Options: gemini, openai, claude, ollama, mock
LLM_PROVIDER=mock
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=http://localhost:11434  # For Ollama

# ── Gemini ──
GEMINI_API_KEY=

# ── OpenAI ──
OPENAI_API_KEY=

# ── Claude / Anthropic ──
ANTHROPIC_API_KEY=

# ── App Settings ──
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
PARSE_CONFIDENCE_THRESHOLD=0.6
CORS_ORIGINS=http://localhost:5173

# ── Embedding Models ──
BI_ENCODER_MODEL=all-MiniLM-L6-v2
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ── Bias ──
COUNTERFACTUAL_DELTA_THRESHOLD=0.05
